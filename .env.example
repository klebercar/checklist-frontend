# Copie para .env.local (dev) e .env.production (build/prod)

# Em DEV, se usar CORS no backend, aponte para o backend local:
# VITE_API_BASE_URL=http://localhost:8080
# Em PROD, aponte para o backend do Render:
# VITE_API_BASE_URL=https://checklist-backend-q3dx.onrender.com

VITE_API_BASE_URL=https://checklist-backend-q3dx.onrender.com
VITE_AUTH_STORAGE_KEY=checklist.auth
